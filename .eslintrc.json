{
  "extends": [
    "react-app",
    "react-app/jest"
  ],
  "plugins": [
    "import"
  ],
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "vars": "all",
        "args": "none",
        "ignoreRestSiblings": true
      }
    ],
    "no-unused-expressions": "warn",
    "import/no-unused-modules": "warn"
  }
}